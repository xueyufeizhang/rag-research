# --- LLM backend selection ---
# "ollama" for a local Ollama server, "api" for any OpenAI-compatible endpoint
LLM_BACKEND=ollama

# Number of chunks processed concurrently during extraction
CON_NUM=5

# --- Ollama backend (used when LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Batch embedding throughput. Reduce the batch size if the embedding model
# exceeds available memory; local Ollama usually needs only low concurrency.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=2

# --- OpenAI-compatible API backend (used when LLM_BACKEND=api) ---
API_BASE_URL=
API_KEY=
API_MODEL=

# Per-request timeout (seconds) for both extraction and embedding calls
EXTRACTION_TIMEOUT=600

# --- Storage ---
# Directory where per-document KV stores, vector indexes and the graph are persisted
WORKING_DIR=./artifacts/stores/dickens_fixed
# Stage caches can be shared by multiple WORKING_DIR experiment outputs.
CACHE_DIR=./artifacts/cache/rag_research

# Labeled retrieval questions used by scripts/evaluate_retrieval.py
EVAL_SET=./data/evaluation/carol_canonical.json

# Fixed tokenizer used only to measure retrieved-context token budgets.
# Keep this unchanged across chunking experiments.
EVAL_TOKENIZER_MODEL=mixedbread-ai/mxbai-rerank-base-v1

# --- Chunking ---
# Available strategies:
# - fixed: character-based sliding window with overlap
# - semantic: sentence-based topic boundary detection using embeddings
# - agentic_ibm: LLM-based topic boundary selection over numbered sentences
CHUNKING_STRATEGY=fixed

# Used when CHUNKING_STRATEGY=fixed
FIXED_WINDOW_SIZE=2400
FIXED_WINDOW_OVERLAP=200

# Used when CHUNKING_STRATEGY=semantic
# Higher percentile means fewer semantic breakpoints and larger chunks.
SEMANTIC_BREAKPOINT_PERCENTILE=92
SEMANTIC_MIN_SENTENCES=10
SEMANTIC_MAX_SENTENCES=32
SEMANTIC_BUFFER_SIZE=1
SEMANTIC_EMBEDDING_BATCH_SIZE=32
SEMANTIC_EMBEDDING_CONCURRENCY=4

# Used when CHUNKING_STRATEGY=agentic_ibm
# The LLM returns sentence boundaries only; chunks are reconstructed verbatim.
AGENTIC_BATCH_MAX_SENTENCES=60
AGENTIC_BATCH_MAX_CHARS=12000
AGENTIC_MIN_SENTENCES=4
AGENTIC_MAX_SENTENCES=20
AGENTIC_CONCURRENCY=4
AGENTIC_RETRIES=2

# --- Retrieve ---
ENABLE_RERANKER=true
RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1
CHUNK_TOP_K=5
CHUNK_CANDIDATE_TOP_K=20
ENTITY_TOP_K=5
RELATION_TOP_K=5
RELATION_CANDIDATE_TOP_K=20
